VITE_GOOGLE_SHEETS_ID=YOUR_GOOGLE_SHEETS_ID_HERE
VITE_GOOGLE_SHEETS_API_KEY=YOUR_GOOGLE_SHEETS_API_KEY_HERE
VITE_PUBLIC_SITE_ORIGIN=https://softqueerwealth.com
# Analytics is enabled only for production builds (see .env.production). Staging builds use .env.staging.
VITE_ENABLE_ANALYTICS=false
# Soft Letters stays out of the header on local and staging builds.
VITE_ENABLE_SOFT_LETTERS=false
